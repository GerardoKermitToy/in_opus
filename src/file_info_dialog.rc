#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_OPUS_UNIFIED DIALOGEX 0, 0, 341, 164
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Read-only Ogg Opus information. This plugin does not modify tags.", -1, 6, 5, 329, 20
    EDITTEXT IDC_INFO_TAGS, 6, 28, 329, 130, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
END

IDD_OPUS_FILE_INFO DIALOGEX 0, 0, 360, 340
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Opus File Information"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "", IDC_INFO_TITLE, 14, 12, 332, 18, SS_ENDELLIPSIS | SS_NOPREFIX
    LTEXT "Artist:", -1, 14, 38, 78, 12
    LTEXT "", IDC_INFO_ARTIST, 100, 38, 246, 12, SS_ENDELLIPSIS | SS_NOPREFIX
    LTEXT "Album:", -1, 14, 54, 78, 12
    LTEXT "", IDC_INFO_ALBUM, 100, 54, 246, 12, SS_ENDELLIPSIS | SS_NOPREFIX
    GROUPBOX "Audio", -1, 12, 74, 336, 116
    LTEXT "Format:", -1, 24, 88, 102, 12
    LTEXT "", IDC_INFO_FORMAT, 132, 88, 204, 12, SS_ENDELLIPSIS | SS_NOPREFIX
    LTEXT "Duration:", -1, 24, 103, 102, 12
    LTEXT "", IDC_INFO_DURATION, 132, 103, 204, 12, SS_NOPREFIX
    LTEXT "Average bitrate:", -1, 24, 118, 102, 12
    LTEXT "", IDC_INFO_BITRATE, 132, 118, 204, 12, SS_NOPREFIX
    LTEXT "Source channels:", -1, 24, 133, 102, 12
    LTEXT "", IDC_INFO_CHANNELS, 132, 133, 204, 12, SS_NOPREFIX
    LTEXT "PCM output:", -1, 24, 148, 102, 12
    LTEXT "", IDC_INFO_OUTPUT, 132, 148, 204, 12, SS_NOPREFIX
    LTEXT "", IDC_INFO_STATUS, 24, 164, 312, 23, SS_NOPREFIX
    LTEXT "Tags and stream information:", -1, 14, 198, 332, 12
    EDITTEXT IDC_INFO_TAGS, 14, 213, 332, 72, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT "&File / URL:", -1, 14, 295, 60, 12
    EDITTEXT IDC_INFO_PATH, 80, 293, 266, 15, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 12, 315, 336, 1
    DEFPUSHBUTTON "&Close", IDOK, 290, 322, 58, 16
END

IDD_OPUS_CONFIG DIALOGEX 0, 0, 420, 340
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Winamp Opus Settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    GROUPBOX "Output channels", -1, 12, 8, 396, 62
    CONTROL "S&ource channels (default)", IDC_OUTPUT_SOURCE, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 24, 25, 220, 13
    CONTROL "&Stereo", IDC_OUTPUT_STEREO, "Button", BS_AUTORADIOBUTTON, 270, 25, 120, 13
    LTEXT "Keep 1-8 channels. Unsupported layouts and live radio use stereo.", -1, 24, 44, 372, 20
    GROUPBOX "PCM output", -1, 12, 78, 396, 70
    LTEXT "Sample rate (Hz):", -1, 24, 97, 86, 12
    COMBOBOX IDC_PCM_RATE, 116, 93, 88, 130, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "Resolution:", -1, 224, 97, 62, 12
    COMBOBOX IDC_PCM_BITS, 294, 93, 102, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Resampler quality:", -1, 24, 122, 100, 12
    COMBOBOX IDC_RESAMPLE_QUALITY, 130, 118, 52, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "0: fastest, 10: highest. Bypassed at 48 kHz.", -1, 194, 122, 202, 20
    GROUPBOX "ReplayGain / R128", -1, 12, 156, 396, 89
    LTEXT "Gain mode:", -1, 24, 175, 82, 12
    COMBOBOX IDC_GAIN_MODE, 116, 171, 280, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "File gain (dB):", -1, 24, 202, 70, 12
    EDITTEXT IDC_PRE_GAIN, 96, 198, 46, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Radio gain:", -1, 154, 202, 62, 12
    EDITTEXT IDC_RADIO_GAIN, 218, 198, 46, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Target LUFS:", -1, 278, 202, 70, 12
    EDITTEXT IDC_TARGET_LUFS, 352, 198, 44, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Target loudness applies only when an R128 track/album gain is present.", -1, 24, 222, 372, 18
    CONTROL "Enable &dithering", IDC_DITHER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 254, 178, 13
    CONTROL "Show &instant bitrate", IDC_INSTANT_BR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 218, 254, 190, 13
    CONTROL "Use Winamp's &unified file information dialog (local files)", IDC_UNIFIED_INFO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 275, 394, 13
    LTEXT "Audio changes take effect on the next playback. Tag editing is not supported.", -1, 14, 294, 394, 13
    LTEXT "", IDC_OUTPUT_STATUS, 14, 310, 260, 26, SS_NOPREFIX
    DEFPUSHBUTTON "&OK", IDOK, 280, 318, 58, 16
    PUSHBUTTON "&Cancel", IDCANCEL, 348, 318, 60, 16
END
